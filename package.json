{
  "name": "fork-wallet",
  "version": "0.3.0",
  "description": "Test-only EIP-1193 wallet for Playwright that submits real transactions through your own loopback Anvil node",
  "license": "MIT",
  "type": "commonjs",
  "main": "src/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./src/index.js"
    },
    "./anvil": {
      "types": "./anvil.d.ts",
      "default": "./src/anvil.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "index.d.ts",
    "anvil.d.ts",
    "README.md",
    "docs/api.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec test/unit.test.js test/provider.test.js test/signing.test.js test/legacy-provider.test.js",
    "test:legacy": "node test/run-gate.js test/legacy-compat.test.js",
    "test:sdk": "node test/run-gate.js test/anvil.test.js test/sdk-compat.test.js test/signing-compat.test.js test/integration.test.js",
    "test:integration": "node test/run-gate.js test/integration.test.js",
    "test:all": "npm test && npm run test:sdk",
    "test:pack": "node test/pack-consumer.js",
    "test:pack:runtime": "node test/pack-consumer.js --runtime",
    "test:aave:logic": "node examples/aave/selfcheck.js",
    "test:aave": "node examples/aave/gate.js",
    "test:aave:harness": "node examples/aave/harness.js"
  },
  "peerDependencies": {
    "playwright": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@wagmi/core": "2.22.1",
    "esbuild": "0.28.2",
    "ethers": "6.17.0",
    "playwright": "1.56.1",
    "viem": "2.57.12"
  }
}
